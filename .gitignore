# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

/dist/
/outputs/
/work/

# local issue tracker (see docs/agents/issue-tracker.md)
.scratch/

# real model credentials (ADR-0005: key never enters source or build output)
/pdfstudio/config.json

# PDF Studio 的书架：是你的书和阅读记录，不是仓库内容
pdfstudio/.library/

# 本地模型权重：几百 MB，不进仓库
pdfstudio/.models/

# Electron 构建产物
pdfstudio/dist/
pdfstudio/release/

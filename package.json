{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:pdfstudio": "vitest run --config pdfstudio/vitest.config.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "eval:recognizer": "tsx pdfstudio/eval/run-recognizer.ts",
    "eval:retrieval": "tsx pdfstudio/eval/retrieval/run.ts",
    "dev:pdfstudio": "vite --config pdfstudio/vite.app.config.ts",
    "eval:clips": "tsx pdfstudio/eval/retrieval/build-clips.ts",
    "build:pdfstudio": "vite build --config pdfstudio/vite.app.config.ts --outDir dist/renderer --emptyOutDir",
    "build:electron": "esbuild pdfstudio/electron/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=pdfstudio/dist/main.mjs --external:electron --external:@huggingface/transformers --external:sirv --external:onnxruntime-node --packages=external",
    "dev:electron": "npm run build:electron && PDFSTUDIO_DEV_SERVER=http://localhost:5174 electron pdfstudio/dist/main.mjs",
    "app:pdfstudio": "npm run build:pdfstudio && npm run build:electron && electron pdfstudio/dist/main.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@assistant-ui/react": "^0.15.14",
    "@huggingface/transformers": "^4.2.0",
    "ai": "^7.0.64",
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.4",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "sirv": "^3.0.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

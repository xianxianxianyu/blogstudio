{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@assistant-ui/react": "^0.15.14",
    "ai": "^7.0.64",
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.4",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "streamdown": "^2.5.0",
    "sirv": "^3.0.2"
  },
  "type": "module",
  "description": "PDF Studio — 本地优先的论文阅读与摘录工具",
  "author": "xianxianxianyu",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:pdfstudio": "vitest run --config pdfstudio/vitest.config.ts",
    "typecheck:pdfstudio": "tsc --noEmit -p pdfstudio/tsconfig.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern 'pdfstudio/dist'",
    "db:generate": "drizzle-kit generate",
    "eval:recognizer": "tsx pdfstudio/eval/run-recognizer.ts",
    "eval:retrieval": "tsx pdfstudio/eval/retrieval/run.ts",
    "dev:pdfstudio": "vite --config pdfstudio/vite.app.config.ts",
    "eval:clips": "tsx pdfstudio/eval/retrieval/build-clips.ts",
    "build:pdfstudio": "vite build --config pdfstudio/vite.app.config.ts --outDir ../dist/renderer --emptyOutDir",
    "build:electron": "esbuild pdfstudio/electron/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=pdfstudio/dist/main.mjs --external:electron",
    "dev:electron": "npm run build:electron && PDFSTUDIO_DEV_SERVER=http://localhost:5174 electron pdfstudio/dist/main.mjs",
    "app:pdfstudio": "npm run build:pdfstudio && npm run build:electron && electron pdfstudio/dist/main.mjs",
    "dist:pdfstudio": "npm run build:pdfstudio && npm run build:electron && node pdfstudio/electron/write-app-package.mjs && (electron-builder --config pdfstudio/electron-builder.yml; git checkout -- package.json)"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
